# =========================================================================
# Jeevikaa Couture — Environment Variables
# Copy this file to `.env` and fill in the real values.
# =========================================================================

# ------ MongoDB (legacy, not used after Supabase migration) ------
MONGO_URL=mongodb://localhost:27017
DB_NAME=jeevikaa_couture

# ------ App public base URL ------
# For local development: http://localhost:3000
# For production (Vercel): https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------ Supabase (required) ------
# Get these from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # server-side only, KEEP SECRET

# ------ JWT secret (required) ------
# Generate a strong random string, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# ------ SMTP / Gmail (optional — emails are mocked if left blank) ------
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Jeevikaa Couture <your-email@gmail.com>"
